# ──────────────────────────────────────────────────────────
# AI Stack — Environment Variables
# Copy to .env and change all values marked CHANGEME
# Generate secrets with: openssl rand -hex 32
# ──────────────────────────────────────────────────────────

# ── Ollama ────────────────────────────────────────────────
OLLAMA_API_KEY=

# ── Libre Chat ────────────────────────────────────────────
LIBRECHAT_JWT_SECRET=
LIBRECHAT_JWT_REFRESH_SECRET=
LIBRECHAT_CREDS_KEY=
LIBRECHAT_CREDS_IV=
LIBRECHAT_MEILI_KEY=
SEARXNG_INSTANCE_URL=
LIBRECHAT_CODE_API_KEY=


# ── N8N ───────────────────────────────────────────────────
N8N_HOST=
N8N_ENCRYPTION_KEY=
N8N_JWT_SECRET=

# ── Neo4j ─────────────────────────────────────────────────
NEO4J_USER=
NEO4J_PASSWORD=

# ── LiteLLM ──────────────────────────────────────────────
LITELLM_MASTER_KEY=

# ── Langfuse ─────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_DB_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_USER_EMAIL=
LANGFUSE_USER_NAME=
LANGFUSE_USER_PASSWORD=
