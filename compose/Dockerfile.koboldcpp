FROM nvidia/cuda:12.6.3-devel-ubuntu24.04 AS build

RUN apt-get update && apt-get install -y \
    git \
    build-essential \
    python3 \
    python3-pip \
    python3-dev \
    libcurl4-openssl-dev \
    libssl-dev \
    curl \
    bzip2 \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/usr/local/cuda/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"

WORKDIR /build

RUN git clone --depth 1 https://github.com/Elypha/hybrid-cpp.git .

# Linux CUDA build flag is LLAMA_CUBLAS=1 (not LLAMA_CUDA=1)
# CUDA_DOCKER_ARCH required for Docker builds
RUN CUDA_DOCKER_ARCH=sm_86 make LLAMA_CUBLAS=1 -j$(nproc)

RUN echo "=== Built .so files ===" && ls -lh *.so 2>/dev/null || echo "no .so files"

# ── Runtime ────────────────────────────────────────────────
FROM nvidia/cuda:12.6.3-devel-ubuntu24.04

ENV PATH="/usr/local/cuda/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"

RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    libcurl4 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --break-system-packages numpy sentencepiece requests

WORKDIR /app

COPY --from=build /build/koboldcpp.py .
COPY --from=build /build/*.so .
COPY --from=build /build/*.embd .

EXPOSE 5001

ENTRYPOINT ["python3", "koboldcpp.py"]